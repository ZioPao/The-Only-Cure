    {
      "id": "readme_amputation_mechanic",
      "label": "Amputation Mechanic",
      "file_type": "concept",
      "source_file": "C:\\Users\\picch\\Zomboid\\mods\\The-Only-Cure\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Saw right-click or drag-and-drop cuts off the infected limb; bandages/stitches auto-used to boost survival, tourniquet placed on correct side dampens post-amputation damage; upper arm amputation blocks prosthesis equipping; amputated side gains skill for timed actions"
    },
    {
      "id": "readme_cicatrization",
      "label": "Cicatrization",
      "file_type": "concept",
      "source_file": "C:\\Users\\picch\\Zomboid\\mods\\The-Only-Cure\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Gradual wound healing after amputation; player must periodically clean wounds with bandages; a prosthesis can be equipped before full cicatrization but risks random bleedings — design intent is to reward post-surgery maintenance"
    },
    {
      "id": "readme_prosthesis",
      "label": "Prosthesis (Hook and Arm)",
      "file_type": "concept",
      "source_file": "C:\\Users\\picch\\Zomboid\\mods\\The-Only-Cure\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Two prosthesis types exist: Hook (cheaper, actions take longer) and Arm (faster actions at 1.1x speed modifier), trading craft cost for action speed; equipping slowly grants Prosthesis Familiarity"
    },
