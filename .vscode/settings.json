{
    "Lua.workspace.library": [
        "${addons}/umbrella-unstable/module/library"
    ],
    "Lua.runtime.version": "Lua 5.1",
    "Lua.runtime.path": [
        "?.lua",
        "?/init.lua",
        "server/?.lua"
    ],
    "Lua.completion.requireSeparator": "/",
    "Lua.runtime.builtin": {
        "debug": "disable",
        "io": "disable",
        "package": "disable"
    },
    "Lua.workspace.checkThirdParty": false,
    "Lua.workspace.ignoreDir": [
        ".vscode",
        "dev_stuff",
        "tests",
        "workshop_files"
    ],
    "Lua.diagnostics.globals": [
        "FHSwapHandsAction",
        "timer"
    ],
    // Machine-dependent Project Zomboid install used by the in-game ZBSpec
    // tests. tests/run.ps1 / tests/run.sh read this and inject it as
    // `game_path` into tests/spec/zbspec.yml at run time.
    "zbspec_game_path": "C:\\Steam\\steamapps\\common\\ProjectZomboid"

}